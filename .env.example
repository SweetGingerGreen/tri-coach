# Copy to .env and adjust for your local setup. Do not commit .env.

# --- Retrieval (embeddings) ---
# URL of the local Ollama server used for embedding the query.
TRI_RAG_EMBEDDING_OLLAMA_URL=http://127.0.0.1:11434

# --- Generation (chat) ---
# One of: ollama | openai-compatible | dry-run
TRI_RAG_PROVIDER=ollama

# Base URL for the chat backend. For local Ollama, same as the embedding URL.
# For a remote OpenAI-compatible endpoint, point at https://<host>/v1.
TRI_RAG_CHAT_BASE_URL=http://127.0.0.1:11434

# API key for the openai-compatible provider. Leave unset for local Ollama.
# The CLI reads the key from whichever env var --api-key-env points to
# (default: OPENAI_API_KEY).
OPENAI_API_KEY=
